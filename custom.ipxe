#!ipxe
###
### netboot.xyz-custom menu
###

:custom
clear custom_choice
menu Custom
item --gap UniFi Protect Viewer
item upv_kiosk ${space} Debian 13 kiosk
choose custom_choice || goto custom_exit
echo ${cls}
goto ${custom_choice}
goto custom_exit

:upv_kiosk
isset ${upv_sel} || goto upv_defaults
goto upv_menu

:upv_defaults
set upv_ask 0
set upv_confirm 0
set upv_wifi 0
set upv_sel upv_install

:upv_menu
iseq ${upv_ask} 1 && set upv_ask_box [x] || set upv_ask_box [${space}]
iseq ${upv_confirm} 1 && set upv_confirm_box [x] || set upv_confirm_box [${space}]
iseq ${upv_wifi} 1 && set upv_wifi_box [x] || set upv_wifi_box [${space}]
menu Debian 13 kiosk
item upv_toggle_ask ${upv_ask_box} Choose disk
item upv_toggle_confirm ${upv_confirm_box} Confirm erase
item upv_toggle_wifi ${upv_wifi_box} Wi-Fi
item --gap
item upv_install Install
choose --default ${upv_sel} upv_sel || goto custom
goto ${upv_sel}

:upv_toggle_ask
iseq ${upv_ask} 1 && set upv_ask 0 || set upv_ask 1
goto upv_menu

:upv_toggle_confirm
iseq ${upv_confirm} 1 && set upv_confirm 0 || set upv_confirm 1
goto upv_menu

:upv_toggle_wifi
iseq ${upv_wifi} 1 && set upv_wifi 0 || set upv_wifi 1
goto upv_menu

:upv_install
echo ${cls}
# Disk choice swaps the preseed file. The other options add short flags to
# the boot line only when switched on, so the default line is unchanged.
iseq ${upv_ask} 1 && set upv_preseed preseed-ask.cfg || set upv_preseed preseed.cfg
clear upv_args
iseq ${upv_confirm} 1 && set upv_args ${upv_args} upv_confirm=1 ||
iseq ${upv_wifi} 1 && set upv_args ${upv_args} upv_wifi=1 ||
set upv_base https://raw.githubusercontent.com/${github_user}/netboot.xyz-custom/master/unifi-protect-viewer
iseq ${buildarch} arm64 && set deb_arch arm64 || set deb_arch amd64
set deb_root http://deb.debian.org/debian/dists/trixie/main/installer-${deb_arch}/current/images/netboot/debian-installer/${deb_arch}
set deb_firmware https://cdimage.debian.org/cdimage/firmware/trixie/current/firmware.cpio.gz
imgfree
# Keep the boot line as close as possible to netboot.xyz's own Debian entry.
# Passing passwords and the Protect login here caused a kernel panic
# (no initrd) on a UP Squared, so the installer asks for them instead.
kernel ${deb_root}/linux auto=true priority=critical preseed/url=${upv_base}/${upv_preseed} ${upv_args} initrd=initrd.magic
initrd ${deb_root}/initrd.gz
# The netboot initrd has no non-free firmware, so NICs like Realtek
# fail at "Detect network hardware" without this.
initrd ${deb_firmware} || echo No firmware bundle
iseq ${platform} efi && iseq ${deb_arch} amd64 && shim ${deb_root}/bootnetx64.efi ||
iseq ${platform} efi && iseq ${deb_arch} arm64 && shim ${deb_root}/bootnetaa64.efi ||
boot || goto custom

:custom_exit
chain utils.ipxe
exit
